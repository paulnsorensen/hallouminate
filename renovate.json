{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Automerge patch updates after the required checks pass",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates from 1.0 and later; a 0.x minor can break",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "description": "Keep language toolchain updates for a human",
      "matchDepNames": ["rust", "node", "nodejs", "python", "go", "golang"],
      "automerge": false
    }
  ]
}