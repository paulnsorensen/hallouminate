# libFuzzer dictionary for the hallouminate markdown parsers.
claim_open="<!--claim:"
comment_open="<!--"
comment_close="-->"
status_confirmed="confirmed"
status_qualified="qualified"
status_superseded="superseded"
status_contradicted="contradicted"
attr_ref=" ref="
attr_note=" note=\""
footnote_ref="[^"
footnote_def="]: "
fence="---\x0a"
fence_crlf="---\x0d\x0a"
yaml_status="status: "
yaml_list="\x0a- "
h1="# "
h2="## "
h3="### "
h4="#### "
code_fence="```"
link="](https://"
crlf="\x0d\x0a"
multibyte="\xc3\xa9"
wide="\xe2\x80\x94"
emoji="\xf0\x9f\xa7\x80"
nul="\x00"
parent="../"
current="./"
slash="/"
backslash="\\"
md_ext=".md"
wikilink_open="[["
wikilink_close="]]"
wikilink_alias="|"
rst_title="====="
rst_section="-----"
index_start="<!-- HALLOUMINATE:INDEX-START -->"
index_end="<!-- HALLOUMINATE:INDEX-END -->"
setext="\x0a===\x0a"
# format_handlers: PDF, ZIP, CSV, and JSON tokens.
pdf_magic="%PDF-"
pdf_obj=" 0 obj"
pdf_endobj="endobj"
pdf_stream="stream\x0a"
pdf_endstream="endstream"
pdf_xref="xref"
pdf_trailer="trailer"
pdf_startxref="startxref"
pdf_dict_open="<<"
pdf_dict_close=">>"
pdf_ref=" 0 R"
pdf_eof="%%EOF"
zip_local="PK\x03\x04"
zip_central="PK\x01\x02"
zip_end="PK\x05\x06"
csv_quote="\"\""
csv_comma=","
json_open="{\""
json_colon="\": "
